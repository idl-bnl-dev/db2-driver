{
    "name": "idl-bnl-dev/db2-driver",
    "description": "DB2 for IBM iSeries drop-in Laravel driver",
    "keywords": [
        "ID Logistics",
        "laravel",
        "db2-driver"
    ],
    "homepage": "https://github.com/idl-bnl-dev/db2-driver",
    "license": "MIT",
    "authors": [
        {
            "name": "Bennett Black",
            "email": "bennett@sent.com",
            "role": "Developer"
        },
        {
            "name": "Niels Hamelink",
            "email": "nhamelink@id-logistics.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "larastan/larastan": "^3.13",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "BWICompanies\\DB2Driver\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BWICompanies\\DB2Driver\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --coverage-html=build/coverage --coverage-text=build/coverage.txt --coverage-clover=build/logs/clover.xml",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BWICompanies\\DB2Driver\\DB2DriverServiceProvider",
                "BWICompanies\\DB2Driver\\DB2ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
