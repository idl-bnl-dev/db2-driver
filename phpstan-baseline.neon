parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_null\(\) with Illuminate\\Database\\Schema\\Grammars\\Grammar will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: src/DB2Connection.php

		-
			message: '#^Call to function is_array\(\) with string\|null will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 2
			path: src/DB2Processor.php

		-
			message: '#^Method BWICompanies\\DB2Driver\\DB2Processor\:\:processInsertGetId\(\) should return int but returns list\.$#'
			identifier: return.type
			count: 1
			path: src/DB2Processor.php

		-
			message: '#^Offset ''order'' on array\{select\: list\<mixed\>, from\: list\<mixed\>, join\: list\<mixed\>, where\: list\<mixed\>, groupBy\: list\<mixed\>, having\: list\<mixed\>, order\: list\<mixed\>, union\: list\<mixed\>, \.\.\.\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: src/DB2QueryGrammar.php

		-
			message: '#^Property BWICompanies\\DB2Driver\\DB2QueryGrammar\:\:\$dateFormat \(string\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/DB2QueryGrammar.php

		-
			message: '#^Call to an undefined method Illuminate\\Support\\Fluent\:\:default\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Schema/DB2Blueprint.php

		-
			message: '#^Call to function is_null\(\) with string will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 2
			path: src/Schema/DB2Blueprint.php

		-
			message: '#^Method BWICompanies\\DB2Driver\\Schema\\DB2Blueprint\:\:setReplyListSequenceNumber\(\) with return type void returns int but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: src/Schema/DB2Blueprint.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Connection\:\:getDefaultSchema\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Schema/DB2Builder.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Connection\:\:resetCurrentSchema\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Schema/DB2Builder.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Connection\:\:setCurrentSchema\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Schema/DB2Builder.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Query\\Processors\\Processor\:\:processColumnListing\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Schema/DB2Builder.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Schema\\Grammars\\Grammar\:\:compileColumnExists\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Schema/DB2Builder.php

		-
			message: '#^Property Illuminate\\Database\\Schema\\Builder\:\:\$resolver \(Closure\) in isset\(\) is not nullable\.$#'
			identifier: isset.property
			count: 1
			path: src/Schema/DB2Builder.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: src/Schema/DB2Builder.php

		-
			message: '#^Access to an undefined property Illuminate\\Support\\Fluent\:\:\$allowed\.$#'
			identifier: property.notFound
			count: 1
			path: src/Schema/DB2SchemaGrammar.php

		-
